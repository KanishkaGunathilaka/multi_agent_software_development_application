# Application environment
NODE_ENV=development
PORT=3000

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=                    # optional – required for cloud-hosted Ollama

# Vector DB
VECTOR_DB_URL=https://example.pinecone.io

# Logging
LOG_LEVEL=info
ENABLE_EXPERIMENTAL=false

# PostgreSQL (example)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=research_assistant
